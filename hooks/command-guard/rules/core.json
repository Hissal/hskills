{
  "version": 1,
  "protected": {
    "posix": {
      "exact": ["/var", "/home", "/Users", "/opt", "/root", "/Library", "/Applications", "/private", "/private/var", "/mnt", "/media", "/Volumes", "/srv", "/snap"],
      "tree": ["/bin", "/boot", "/dev", "/etc", "/lib", "/lib32", "/lib64", "/proc", "/sbin", "/sys", "/usr", "/System", "/private/etc"]
    },
    "windows": {
      "exact": ["%SystemDrive%/Users"],
      "tree": ["%SystemRoot%", "%ProgramFiles%", "%ProgramFiles(x86)%", "%ProgramData%"]
    }
  },
  "devices": "^(/dev/(sd|hd|vd|xvd|nvme|mmcblk|disk|rdisk|dm-|md|mapper/|loop)|[\\\\/]{2}[.?][\\\\/](physicaldrive|harddisk|[a-z]:))",
  "downloaders": ["curl", "wget", "fetch", "http", "https", "aria2c", "iwr", "irm", "invoke-webrequest", "invoke-restmethod"],
  "rules": [
    { "id": "fs.rm", "family": "destructive-filesystem", "tier": "human-required", "shells": ["bash"],
      "command": ["rm"], "check": "recursiveDelete", "params": { "kind": "rm" },
      "effect": "recursively deletes a protected location" },
    { "id": "fs.remove-item", "family": "destructive-filesystem", "tier": "human-required", "shells": ["powershell"],
      "command": ["remove-item", "ri", "rm", "rmdir", "rd", "del", "erase"], "check": "recursiveDelete", "params": { "kind": "remove-item" },
      "effect": "recursively deletes a protected location" },
    { "id": "fs.rd", "family": "destructive-filesystem", "tier": "human-required", "shells": ["cmd"],
      "command": ["rd", "rmdir", "del", "erase"], "check": "recursiveDelete", "params": { "kind": "rd" },
      "effect": "recursively deletes a protected location" },
    { "id": "fs.find-delete", "family": "destructive-filesystem", "tier": "human-required", "shells": ["bash"],
      "command": ["find"], "check": "recursiveDelete", "params": { "kind": "find" },
      "effect": "deletes everything find matches under a protected location" },
    { "id": "fs.robocopy-mirror", "family": "destructive-filesystem", "tier": "human-required",
      "command": ["robocopy"], "check": "recursiveDelete", "params": { "kind": "robocopy" },
      "effect": "purges a protected destination to mirror the source" },
    { "id": "fs.rsync-delete", "family": "destructive-filesystem", "tier": "human-required", "shells": ["bash"],
      "command": ["rsync"], "check": "recursiveDelete", "params": { "kind": "rsync" },
      "effect": "deletes from a protected destination whatever the source lacks" },

    { "id": "disk.dd", "family": "destructive-filesystem", "tier": "human-required",
      "command": ["dd"], "check": "ddDevice", "effect": "overwrites a raw disk" },
    { "id": "disk.redirect", "family": "destructive-filesystem", "tier": "human-required",
      "check": "redirectDevice", "effect": "overwrites a raw disk" },
    { "id": "disk.mkfs", "family": "destructive-filesystem", "tier": "human-required",
      "commandPattern": "^(mkfs(\\..+)?|mke2fs|wipefs|blkdiscard)$", "effect": "formats or wipes a disk" },
    { "id": "disk.shred", "family": "destructive-filesystem", "tier": "human-required",
      "command": ["shred"], "anyArg": "^/dev/", "effect": "overwrites a raw disk" },
    { "id": "disk.diskutil", "family": "destructive-filesystem", "tier": "human-required",
      "command": ["diskutil"], "sub": [["erasedisk|erasevolume|partitiondisk|zerodisk|randomdisk|secureerase|reformat"]], "effect": "erases or repartitions a disk" },
    { "id": "disk.format", "family": "destructive-filesystem", "tier": "human-required", "shells": ["powershell", "cmd"],
      "command": ["format"], "anyArg": "^[A-Za-z]:\\\\?$", "effect": "formats a drive" },
    { "id": "disk.ps-format", "family": "destructive-filesystem", "tier": "human-required",
      "command": ["format-volume", "clear-disk", "initialize-disk", "remove-partition", "diskpart"], "effect": "formats, clears or repartitions a disk" },

    { "id": "git.force-push-default", "family": "force-push-default-branch", "tier": "human-required",
      "command": ["git"], "check": "gitForcePush", "effect": "overwrites the remote default branch without a lease" },

    { "id": "cred.op", "family": "credential-store", "tier": "human-required", "command": ["op"], "subAnywhere": true,
      "sub": [["read"], ["inject"], ["run"], ["signin"], ["item", "get|delete|edit"], ["document", "get|delete"], ["vault", "delete"]],
      "effect": "reveals, injects or destroys 1Password secrets" },
    { "id": "cred.bw", "family": "credential-store", "tier": "human-required", "command": ["bw"], "subAnywhere": true,
      "sub": [["get"], ["export"], ["unlock"], ["delete"], ["serve"], ["list", "items"]],
      "effect": "reveals, exports or destroys Bitwarden secrets" },
    { "id": "cred.bws", "family": "credential-store", "tier": "human-required", "command": ["bws"], "subAnywhere": true,
      "sub": [["run"], ["secret", "get|list|delete"]], "effect": "reveals, injects or destroys Bitwarden Secrets Manager secrets" },
    { "id": "cred.lpass", "family": "credential-store", "tier": "human-required", "command": ["lpass"],
      "sub": [["show|export|rm"]], "effect": "reveals, exports or destroys LastPass secrets" },
    { "id": "cred.keepassxc", "family": "credential-store", "tier": "human-required", "command": ["keepassxc-cli"],
      "sub": [["show|export|clip|rm|attachment-export"]], "effect": "reveals, exports or destroys KeePassXC secrets" },
    { "id": "cred.rbw", "family": "credential-store", "tier": "human-required", "command": ["rbw"],
      "sub": [["get|code|remove|rm"]], "effect": "reveals or destroys Bitwarden secrets" },
    { "id": "cred.nordpass", "family": "credential-store", "tier": "human-required", "command": ["nordpass"],
      "sub": [["get|export|delete"]], "effect": "reveals, exports or destroys NordPass secrets" },
    { "id": "cred.gopass", "family": "credential-store", "tier": "human-required", "command": ["gopass"],
      "sub": [["show|cat|rm|delete|otp"]], "effect": "reveals or destroys gopass secrets" },
    { "id": "cred.pass", "family": "credential-store", "tier": "human-required", "shells": ["bash"], "command": ["pass"],
      "firstPositionalNot": ["ls", "list", "find", "search", "version", "help", "git", "init", "insert", "add", "generate", "edit", "mv", "rename", "cp", "copy"],
      "effect": "reveals or destroys a password-store secret" },
    { "id": "cred.pass-clip", "family": "credential-store", "tier": "human-required", "shells": ["bash"], "command": ["pass"],
      "anyFlag": ["-c", "--clip"], "effect": "copies a password-store secret out of the store" },
    { "id": "cred.macos-keychain", "family": "credential-store", "tier": "human-required", "command": ["security"],
      "sub": [["dump-keychain|export|delete-keychain|delete-generic-password|delete-internet-password|delete-certificate|delete-identity"]],
      "effect": "dumps, exports or destroys macOS keychain items" },
    { "id": "cred.macos-keychain-read", "family": "credential-store", "tier": "human-required", "command": ["security"],
      "sub": [["find-generic-password|find-internet-password"]], "anyFlag": ["-w", "-g"],
      "effect": "prints a macOS keychain password" },
    { "id": "cred.secret-tool", "family": "credential-store", "tier": "human-required", "command": ["secret-tool"],
      "sub": [["lookup|clear"]], "effect": "reveals or destroys a Secret Service secret" },
    { "id": "cred.python-keyring", "family": "credential-store", "tier": "human-required", "command": ["keyring"],
      "sub": [["get|del"]], "effect": "reveals or destroys an OS keyring secret" },
    { "id": "cred.cmdkey", "family": "credential-store", "tier": "human-required", "command": ["cmdkey"],
      "anyArg": "^[/-]delete", "effect": "deletes stored Windows credentials" },
    { "id": "cred.ps-secrets", "family": "credential-store", "tier": "human-required",
      "command": ["get-secret", "remove-secret", "get-storedcredential", "remove-storedcredential", "unregister-secretvault", "export-pfxcertificate"],
      "effect": "reveals, exports or destroys a stored Windows secret" },
    { "id": "cred.certutil-export", "family": "credential-store", "tier": "human-required", "command": ["certutil"],
      "anyArg": "^[/-]exportpfx$", "effect": "exports a private key" },
    { "id": "cred.gpg-secret", "family": "credential-store", "tier": "human-required", "command": ["gpg", "gpg2"],
      "anyArg": "^--(export-secret-keys?|export-secret-subkeys|delete-secret-keys?|delete-secret-and-public-keys?)$",
      "effect": "exports or destroys GPG private keys" },

    { "id": "db.sql-drop", "family": "database-drop", "tier": "human-required",
      "command": ["psql", "mysql", "mariadb", "sqlite3", "sqlcmd", "invoke-sqlcmd", "clickhouse-client", "duckdb", "cockroach", "bq", "usql", "pgcli", "mycli", "isql", "sqlplus", "tsql"],
      "check": "sqlText", "params": { "pattern": "\\bdrop\\s+(table|database|schema|index|view|materialized\\s+view|function|procedure|trigger|type|role|user|sequence|extension|tablespace|keyspace)\\b|\\btruncate\\s+(table\\s+)?[\\w\"`\\[]" },
      "effect": "drops or truncates database objects" },
    { "id": "db.mongo-drop", "family": "database-drop", "tier": "human-required",
      "command": ["mongosh", "mongo"], "check": "sqlText", "params": { "pattern": "\\.drop(Database|Collection|Index|Indexes)?\\s*\\(" },
      "effect": "drops a MongoDB database, collection or index" },
    { "id": "db.dropdb", "family": "database-drop", "tier": "human-required", "command": ["dropdb"], "effect": "drops a PostgreSQL database" },
    { "id": "db.mysqladmin-drop", "family": "database-drop", "tier": "human-required", "command": ["mysqladmin", "mariadb-admin"],
      "subAnywhere": true, "sub": [["drop"]], "effect": "drops a MySQL database" },
    { "id": "db.ef-drop", "family": "database-drop", "tier": "human-required", "command": ["dotnet", "dotnet-ef"],
      "subAnywhere": true, "sub": [["database", "drop"]], "effect": "drops the Entity Framework database" },
    { "id": "db.prisma-reset", "family": "database-drop", "tier": "human-required", "command": ["prisma", "npx", "pnpm", "yarn", "bunx", "bun"],
      "subAnywhere": true, "sub": [["prisma", "migrate", "reset"], ["migrate", "reset"]], "text": "\\bprisma\\b",
      "effect": "drops and recreates the Prisma database" },
    { "id": "db.prisma-force-reset", "family": "database-drop", "tier": "human-required", "command": ["prisma", "npx", "pnpm", "yarn", "bunx", "bun"],
      "anyFlag": ["--force-reset"], "text": "\\bprisma\\b", "effect": "drops and recreates the Prisma database" },

    { "id": "docker.volume-rm", "family": "docker-volume", "tier": "human-required", "command": ["docker", "podman", "nerdctl"],
      "valueFlags": ["-H", "--host", "--context", "-c", "--config", "-l", "--log-level"],
      "sub": [["volume", "rm|remove|prune"]], "effect": "deletes persistent Docker volumes" },
    { "id": "docker.system-prune-volumes", "family": "docker-volume", "tier": "human-required", "command": ["docker", "podman", "nerdctl"],
      "valueFlags": ["-H", "--host", "--context", "-c", "--config", "-l", "--log-level"],
      "sub": [["system", "prune"]], "anyFlag": ["--volumes"], "effect": "prunes persistent Docker volumes" },
    { "id": "docker.compose-down-volumes", "family": "docker-volume", "tier": "human-required", "command": ["docker", "podman", "nerdctl"],
      "valueFlags": ["-H", "--host", "--context", "-c", "--config", "-l", "--log-level", "-f", "--file", "-p", "--project-name", "--project-directory", "--env-file", "--profile"],
      "sub": [["compose", "down"]], "anyFlag": ["-v", "--volumes"], "effect": "deletes the Compose project's volumes" },
    { "id": "docker.compose-v1-down-volumes", "family": "docker-volume", "tier": "human-required", "command": ["docker-compose", "podman-compose"],
      "valueFlags": ["-f", "--file", "-p", "--project-name", "--project-directory", "--env-file", "--profile"],
      "sub": [["down"]], "anyFlag": ["-v", "--volumes"], "effect": "deletes the Compose project's volumes" },

    { "id": "k8s.delete-namespace", "family": "kubernetes-broad-delete", "tier": "human-required", "command": ["kubectl", "oc"],
      "valueFlags": ["-n", "--namespace", "--context", "--kubeconfig", "-s", "--server", "--cluster", "--user", "--as"],
      "sub": [["delete"]], "anyArg": "^(ns|namespaces?)(/|,|$)", "effect": "deletes a Kubernetes namespace and everything in it" },
    { "id": "k8s.delete-all", "family": "kubernetes-broad-delete", "tier": "human-required", "command": ["kubectl", "oc"],
      "valueFlags": ["-n", "--namespace", "--context", "--kubeconfig", "-s", "--server", "--cluster", "--user", "--as"],
      "sub": [["delete"]], "anyFlag": ["--all", "-A", "--all-namespaces"], "effect": "deletes Kubernetes resources in bulk" },

    { "id": "perm.recursive", "family": "recursive-permissions", "tier": "human-required", "shells": ["bash"],
      "command": ["chmod", "chown", "chgrp"], "check": "recursivePerms", "params": { "kind": "chmod" },
      "effect": "recursively changes permissions or ownership of a protected location" },
    { "id": "perm.icacls", "family": "recursive-permissions", "tier": "human-required",
      "command": ["icacls"], "check": "recursivePerms", "params": { "kind": "icacls" },
      "effect": "recursively changes access control of a protected location" },
    { "id": "perm.takeown", "family": "recursive-permissions", "tier": "human-required",
      "command": ["takeown"], "check": "recursivePerms", "params": { "kind": "takeown" },
      "effect": "recursively takes ownership of a protected location" },

    { "id": "exec.downloaded", "family": "downloaded-execution", "tier": "human-required",
      "check": "downloadExec", "effect": "runs downloaded content without inspection" },

    { "id": "host.fork-bomb", "family": "host-availability", "tier": "human-required",
      "source": "(^|[;&|\\s])([:\\w]+)\\s*\\(\\s*\\)\\s*\\{\\s*\\2\\s*\\|\\s*\\2\\s*&\\s*\\}\\s*;\\s*\\2|%0\\s*\\|\\s*%0", "effect": "fork bomb" },
    { "id": "host.shutdown", "family": "host-availability", "tier": "human-required",
      "command": ["shutdown"], "noArg": "^([/-](a|c|\\?)|--help)$", "effect": "shuts down or reboots the host" },
    { "id": "host.power", "family": "host-availability", "tier": "human-required",
      "command": ["reboot", "halt", "poweroff", "stop-computer", "restart-computer"], "noArg": "^--help$", "effect": "shuts down or reboots the host" },
    { "id": "host.init", "family": "host-availability", "tier": "human-required",
      "command": ["init", "telinit"], "sub": [["0|6"]], "effect": "shuts down or reboots the host" },
    { "id": "host.systemctl", "family": "host-availability", "tier": "human-required",
      "command": ["systemctl"], "subAnywhere": true, "sub": [["poweroff|reboot|halt|kexec"]], "effect": "shuts down or reboots the host" },
    { "id": "host.osascript", "family": "host-availability", "tier": "human-required",
      "command": ["osascript"], "text": "(shut ?down|restart)", "effect": "shuts down or restarts the host" },

    { "id": "git.reflect", "family": "git-discard", "tier": "reflection",
      "command": ["git"], "check": "gitDiscard", "effect": "discards local work" }
  ]
}
